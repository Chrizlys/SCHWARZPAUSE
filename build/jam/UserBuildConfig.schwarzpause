# Schwarzpause OS build overlay.
# Copy this file to build/jam/UserBuildConfig before running configure/jam.

HAIKU_DISTRO_COMPATIBILITY = "default" ;

HAIKU_IMAGE_NAME = schwarzpause.image ;
HAIKU_IMAGE_LABEL = "Schwarzpause OS" ;

HAIKU_CD_NAME = schwarzpause-cd.iso ;
HAIKU_CD_LABEL = "Schwarzpause OS" ;

HAIKU_ANYBOOT_NAME = schwarzpause-anyboot.iso ;
HAIKU_ANYBOOT_LABEL = "Schwarzpause OS" ;

# ============================================================================
#  SCHWARZBrOT model switch
# ----------------------------------------------------------------------------
#  0 = default. The SCHWARZBrOT app, engine and UI are baked in; the ~2.9 GB
#      Qwen model is not, keeping the image small enough to boot from a VM CD
#      and from USB. The model is added separately and found at launch.
#  1 = bake the model in as well. The resulting ~4 GB image does not boot (too
#      large for a VM CD; exceeds the 32-bit boot loader's limit). Experiments
#      only.
# ============================================================================
# Freeze the OS core: do not ship the "Haiku" package repository config, so a
# pkgman operation cannot replace the branded haiku package with the stock one
# (which would revert the branding and remove both applications). HaikuPorts is
# still shipped, so applications keep updating from Haiku's servers normally.
#
# Set to 0 once SCHWARZPAUSE serves its own OS packages from its own repository.
SCHWARZPAUSE_FREEZE_OS_CORE ?= 1 ;

SCHWARZBROT_BAKE_MODEL ?= 0 ;

if $(SCHWARZBROT_BAKE_MODEL) = 1 {
	HAIKU_IMAGE_SIZE = 4096 ;
} else {
	# ~0.66 GB base + engine/UI + ~1.4 GB of preinstalled apps, plus headroom.
	HAIKU_IMAGE_SIZE = 2100 ;
}

HAIKU_IMAGE_HOST_NAME = schwarzpause ;

# ============================================================================
#  Suppress base library packages that a newer version is preinstalled for
# ----------------------------------------------------------------------------
#  The preinstalled applications need newer libraries than upstream's pinned
#  base ships (e.g. zlib 1.3.2 vs 1.3.1, freetype 6.20.6 vs 6.20.4, xz_utils
#  5.8.3 vs 5.6.2). Without this, both versions land in system/packages and the
#  image dependency solve refuses to continue.
#
#  AddHaikuImagePackages skips any package already flagged HAIKU_PACKAGE_ADDED,
#  so pre-flagging the base versions here leaves the preinstalled ones as the
#  sole provider. This runs at file scope on purpose: the repositories are
#  included (so IsPackageAvailable resolves) before this file, and the packages
#  are added afterwards by DefineDefaultBuildProfiles.
#
#  The *_devel entries are the same problem: they pin their runtime partner to
#  an exact version (e.g. zlib_devel requires zlib==1.3.1), which the newer
#  runtime package can no longer satisfy. They are unactivated developer
#  headers, so suppressing them is safe.
#
#  mpfr is a further case: the base ships it only as an unactivated package, but
#  OpenSCAD, rasqal and suitesparse need it activated, so it is preinstalled and
#  the base copy suppressed to avoid a duplicate.
# ============================================================================
local schwarzpauseReplacedPackages = zlib freetype xz_utils
	zlib_devel libjpeg_turbo_devel mpfr ;
local schwarzpauseReplacedPackage ;
for schwarzpauseReplacedPackage in $(schwarzpauseReplacedPackages) {
	local resolved = [ IsPackageAvailable $(schwarzpauseReplacedPackage) ] ;
	if $(resolved) {
		HAIKU_PACKAGE_ADDED on $(resolved) = 1 ;
		Echo "SCHWARZPAUSE: base $(schwarzpauseReplacedPackage) suppressed"
			"(newer version is preinstalled)" ;
	} else {
		Echo "SCHWARZPAUSE: WARNING could not resolve package"
			"$(schwarzpauseReplacedPackage) -- base version may still be added" ;
	}
}

rule UserBuildConfigRulePreImage
{
	AddPackageFilesToHaikuImage system packages :
		schwarzpause_branding.hpkg
		:
		nameFromMetaInfo
		;

	# ------------------------------------------------------------------------
	#  Preinstalled applications
	# ------------------------------------------------------------------------
	#  The complete, dependency-resolved package set for the bundled applications
	#  (LibreOffice, Waterfox, Icedove, VLC, GIMP, Inkscape, QCAD, OpenSCAD,
	#  KolourPaint, BePDF, PDFWriter, DeskNotes).
	#
	#  Shipped as local package files: AddHaikuImagePackages does not resolve
	#  dependencies, so the full closure must be listed explicitly, and pinning
	#  to fixed files keeps the build reproducible against the rolling HaikuPorts
	#  repository. See the note at the AddPackageFilesToHaikuImage call below for
	#  where the files come from.
