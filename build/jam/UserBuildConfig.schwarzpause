	xmlsec-1.2.37-3-x86_64.hpkg
	brotli-1.2.0-1-x86_64.hpkg
	ca_root_certificates-2026_07_16-1-any.hpkg
	expat-2.8.2-1-x86_64.hpkg
	freetype-2.14.3-1-x86_64.hpkg
	gettext_libintl-1.0-1-x86_64.hpkg
	harfbuzz-14.2.0-1-x86_64.hpkg
	libgpg_error-1.61-2-x86_64.hpkg
	libjpeg_turbo-3.1.4.1-1-x86_64.hpkg
	xz_utils-5.8.3-1-x86_64.hpkg
	zlib-1.3.2-1-x86_64.hpkg
	lcms-2.19.1-1-x86_64.hpkg
	mpfr-4.2.0-3-x86_64.hpkg
		;
	# The application packages are not part of the repository (about 1 GB of
	# binaries). When schwarzpause-packages/ is empty the base system is built
	# without them; drop the .hpkg files in to build the full image.
	local schwarzpausePackagesDir
		= [ FDirName $(HAIKU_TOP) schwarzpause-packages ] ;
	if [ Glob $(schwarzpausePackagesDir) : *.hpkg ] {
		SEARCH on $(schwarzpausePreinstall) = $(schwarzpausePackagesDir) ;
		AddPackageFilesToHaikuImage system packages
			: $(schwarzpausePreinstall)
			: nameFromMetaInfo
			;
	} else {
		Echo "SCHWARZPAUSE: schwarzpause-packages/ is empty -- building the base"
			"system without the preinstalled application set." ;
	}

	# ------------------------------------------------------------------------
	#  Preconfigured desktop design
	# ------------------------------------------------------------------------
	#  First-boot defaults for the Deskbar (size, layout), Tracker (icon size,
	#  Disks-vs-Volumes, click behaviour) and workspaces. Machine-specific
	#  settings (keymap, network, screen, touchpad, mouse) are deliberately not
	#  baked. The source files are under data/schwarzpause/settings.
	# ------------------------------------------------------------------------
	# Each target's non-grist base name must equal the real filename on disk;
	# jam resolves it through SEARCH. The grist only makes the targets unique.
	local spSettingsDir = [ FDirName $(HAIKU_TOP) data schwarzpause settings ] ;

	local spDeskbar = <sp-deskbar>settings <sp-deskbar>clock_settings
		<sp-deskbar>replicants ;
	SEARCH on $(spDeskbar) = [ FDirName $(spSettingsDir) deskbar ] ;
	AddFilesToHaikuImage home config settings deskbar : $(spDeskbar) ;

	local spTracker = <sp-tracker>TrackerSettings <sp-tracker>tracker_shelf ;
	SEARCH on $(spTracker) = [ FDirName $(spSettingsDir) Tracker ] ;
	AddFilesToHaikuImage home config settings Tracker : $(spTracker) ;

	local spWorkspaces = <sp-settings>Workspaces_settings ;
	SEARCH on $(spWorkspaces) = $(spSettingsDir) ;
	AddFilesToHaikuImage home config settings : $(spWorkspaces) ;

	# Global boot environment. Disables the Mesa shader disk cache, which
	# corrupts on the live-USB write-overlay and crashes OpenGL apps (OpenSCAD /
	# SCHWARZSEHER) on their second launch. Sourced by data/system/boot/
	# SetupEnvironment, so every GUI app inherits it. (This is a real, active
	# UserSetupEnvironment; the base image also ships a .sample next to it.)
	local spBootEnv = <sp-boot>UserSetupEnvironment ;
	SEARCH on $(spBootEnv) = [ FDirName $(spSettingsDir) boot ] ;
	AddFilesToHaikuImage home config settings boot : $(spBootEnv) ;
}
