/* SCHWARZBrOT application resources.
 *
 * No icon resource is defined here on purpose: the app icon (white rounded tile
 * with the black smiling loaf) is supplied by Tracker/Deskbar through the
 * Schwarzpause PNG icon path in IconCache.cpp (keyed on this application's
 * name), matching the approved PNG-resource icon route used by SCHWARZSEHER
 * and the desktop icons.
 */

resource app_signature "application/x-vnd.schwarzpause-schwarzbrot";

resource app_version {
	major  = 1,
	middle = 0,
	minor  = 0,

	variety = B_APPV_DEVELOPMENT,
	internal = 0,

	short_info = "SCHWARZBrOT",
	long_info  = "SCHWARZBrOT - offline AI chat for Schwarzpause OS"
};

/* B_MULTIPLE_LAUNCH, deliberately.
 *
 * With B_SINGLE_LAUNCH the system does not start a second process while the
 * engine is still running -- it only sends a message to the running instance,
 * and this launcher is not a BApplication, so nothing happens at all. That made
 * the "already running" dialog ([Open chat] / [Remove model]) unreachable and
 * left the user with no way back once the browser window was closed.
 *
 * A second process is harmless: it detects the running server, offers those
 * choices, and exits without starting a second engine. See HandleRunning().
 */
resource app_flags B_MULTIPLE_LAUNCH;
